-- EasyBuy v7: Storefront themes
-- Run AFTER schema_v6_all.sql. Safe to run more than once.

-- =====================================================================
-- Theme preset + config on stores
-- =====================================================================
alter table public.stores add column if not exists theme_preset text not null default 'classic';
alter table public.stores add column if not exists theme_config jsonb not null default '{}'::jsonb;

-- Validate preset name
alter table public.stores drop constraint if exists stores_theme_preset_chk;
alter table public.stores add constraint stores_theme_preset_chk
  check (theme_preset in ('classic','minimal','bold','elegant'));

-- Allow sellers to update these columns
grant update (theme_preset, theme_config) on public.stores to authenticated;

-- =====================================================================
-- Store pages (About, Contact, FAQs, etc.)
-- =====================================================================
create table if not exists public.store_pages (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  slug text not null,
  title text not null,
  content text not null default '',
  published boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (store_id, slug)
);
create index if not exists store_pages_store_idx on public.store_pages(store_id);

alter table public.store_pages enable row level security;

drop policy if exists pages_public_read on public.store_pages;
drop policy if exists pages_owner_write on public.store_pages;

create policy pages_public_read on public.store_pages for select
  using (published and exists(
    select 1 from public.stores s where s.id = store_id and s.published
  ));

create policy pages_owner_write on public.store_pages for all to authenticated
  using (exists(
    select 1 from public.stores s where s.id = store_id and s.owner_id = auth.uid()
  ))
  with check (exists(
    select 1 from public.stores s where s.id = store_id and s.owner_id = auth.uid()
  ));

-- =====================================================================
-- Blog posts
-- =====================================================================
create table if not exists public.store_posts (
  id uuid primary key default gen_random_uuid(),
  store_id uuid not null references public.stores(id) on delete cascade,
  slug text not null,
  title text not null,
  excerpt text not null default '',
  content text not null default '',
  cover_image text not null default '',
  published boolean not null default false,
  published_at timestamptz,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (store_id, slug)
);
create index if not exists store_posts_store_idx on public.store_posts(store_id, published_at desc);

alter table public.store_posts enable row level security;

drop policy if exists posts_public_read on public.store_posts;
drop policy if exists posts_owner_write on public.store_posts;

create policy posts_public_read on public.store_posts for select
  using (published and exists(
    select 1 from public.stores s where s.id = store_id and s.published
  ));

create policy posts_owner_write on public.store_posts for all to authenticated
  using (exists(
    select 1 from public.stores s where s.id = store_id and s.owner_id = auth.uid()
  ))
  with check (exists(
    select 1 from public.stores s where s.id = store_id and s.owner_id = auth.uid()
  ));
